# PulseMeet - Environment Variables Configuration
# Copy this file to .env and fill in your Supabase credentials to enable multi-device backend sync.
# If .env is not present, the app automatically runs in Zero-Config Local Demo Mode.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
