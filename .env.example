# PulseMeet - Environment Variables Configuration
# Copy this file to .env and fill in your Supabase credentials to enable multi-device backend sync.
# If .env is not present, the app automatically runs in Zero-Config Local Demo Mode.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Optional: TURN Relay Configuration ─────────────────────────────────────
# Required for users behind corporate firewalls or symmetric NAT.
# Providers: Metered.ca (free tier), Twilio ICE, or self-hosted Coturn.
# If not set, app uses public STUN + OpenRelay free TURN as fallback.
# VITE_TURN_URL=turn:your-coturn-server.com:3478
# VITE_TURN_USERNAME=your_turn_username
# VITE_TURN_CREDENTIAL=your_turn_credential
